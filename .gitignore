node_modules/
*.log

# NOTE: dist/ is intentionally tracked. OpenClaw's plugin installer runs
# `npm install --omit=dev`, which strips the typescript compiler, so we
# ship the compiled output in-tree. Rebuild before committing source
# changes:  npm run build && git add dist/

# Build artifacts
.tsbuildinfo
*.tsbuildinfo
.cache/
coverage/
.vitest/
.experimental-vitest-cache/

# Local Postgres data (when running dev/docker-compose.yml against host volume)
dev/data/
dev/pgdata/

# Environment / secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test pollution
/tmp/
*.swp
*.bak

# Personal config that should never be committed
**/openclaw.json
**/.dashboard.env
**/auth-profiles.json
**/auth-state.json
